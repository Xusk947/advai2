FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Библиотеки для работы pygame внутри контейнера
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libx11-6 \
        libxext6 \
        libxrender1 \
        libxrandr2 \
        libxcursor1 \
        libxi6 \
        libxinerama1 \
        libxxf86vm1 \
        libasound2 && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Директория для чекпоинтов (общий volume между контейнерами)
VOLUME ["/app/checkpoints"]

# UI запускается через live_view.py (обёртка над live_view.main)
CMD ["python", "live_view.py"]

